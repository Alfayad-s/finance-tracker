{
  "name": "finance-tracker",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=app",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "npm run db:migrate --workspace=api"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "packageManager": "npm@11.17.0"
}
